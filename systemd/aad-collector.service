# Installation (dépôt présent dans /opt/aad) :
#   sudo cp systemd/aad-collector.service /etc/systemd/system/
#   sudo systemctl daemon-reload && sudo systemctl enable --now aad-collector
#
# Root est requis pour un seul capteur : RAPL (energy_uj en 0400 depuis
# Platypus). Tout le reste tourne en utilisateur ordinaire — si la puissance
# CPU ne t'intéresse pas, lance le collector sans systemd et sans root.

[Unit]
Description=AAD — collecte de télémétrie matérielle à 1 Hz

[Service]
Type=simple
StateDirectory=aad
WorkingDirectory=/opt/aad
ExecStart=/usr/bin/python3 -m collector.main --db /var/lib/aad/metrics.db --period 1.0
Restart=always
RestartSec=5

# Le daemon lit /proc, /sys et écrit dans son répertoire de données.
ProtectHome=read-only
ProtectSystem=strict
ReadWritePaths=/var/lib/aad
PrivateTmp=yes
NoNewPrivileges=yes
# Priorité basse : mesurer la machine ne doit pas perturber ce qu'on mesure.
Nice=10
IOSchedulingClass=idle

[Install]
WantedBy=multi-user.target
